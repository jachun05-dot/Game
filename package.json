{
  "name": "ddd-text",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "sim": "vite-node scripts/sim.ts",
    "sim:month1": "vite-node scripts/sim-month1.ts",
    "sim:all": "vite-node scripts/sim-all.ts",
    "sim:boss": "vite-node scripts/sim-boss.ts",
    "build:app": "tsc -b && VITE_TARGET=app vite build",
    "release:pages": "npm run build && scripts/release/pages.sh",
    "release:artifact": "npm run build && node scripts/release/stage-artifact.mjs",
    "check": "tsc -b && vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
